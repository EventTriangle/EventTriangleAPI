{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "fullnameOverride",
    "replicaCount",
    "image",
    "imagePullSecrets",
    "service",
    "ports",
    "autoscaling",
    "ingress",
    "env",
    "secretEnv"
  ],
  "properties": {
    "fullnameOverride": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^([a-z]([-a-z0-9]*[a-z0-9])?)?$"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?$"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      },
      "anyOf": [
        {
          "properties": {
            "tag": {
              "minLength": 1
            }
          }
        },
        {
          "properties": {
            "digest": {
              "minLength": 1
            }
          }
        }
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "service": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/properties/fullnameOverride"
        }
      }
    },
    "ports": {
      "type": "object",
      "required": [
        "http",
        "grpc"
      ],
      "properties": {
        "http": {
          "type": "object",
          "required": [
            "containerPort",
            "servicePort"
          ],
          "properties": {
            "containerPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "servicePort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "grpc": {
          "$ref": "#/properties/ports/properties/http"
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "required": [
        "enabled",
        "minReplicas",
        "maxReplicas",
        "targetCPUUtilizationPercentage"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": [
        "enabled",
        "className",
        "host",
        "routes"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string"
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "path",
              "pathType"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63,
                "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
              },
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "pathType": {
                "enum": [
                  "Prefix",
                  "Exact"
                ]
              },
              "tlsSecretName": {
                "type": "string"
              },
              "annotations": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "host": {
            "minLength": 1
          },
          "routes": {
            "minItems": 1
          }
        }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "secretEnv": {
      "type": "object",
      "required": [
        "DatabaseConnectionString",
        "RabbitMqPassword"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "key"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
